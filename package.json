{
  "name": "vibe-video-editor",
  "version": "1.7.3",
  "description": "Video, image and drawing editor suite with PowerPoint-style GL transitions, layers and AI masks",
  "main": "electron/main.js",
  "author": "Vibe Editing Suite",
  "scripts": {
    "build:ui": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis --publish never",
    "release": "vite build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-web": "^1.30.0"
  },
  "devDependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.vibe.videoeditor",
    "productName": "Vibe Editing Suite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "extraResources": [
      {
        "from": "transitions",
        "to": "transitions"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Vibe-Editing-Suite-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "phsrp",
        "repo": "Vibe-editing-suite",
        "releaseType": "release"
      }
    ]
  }
}
